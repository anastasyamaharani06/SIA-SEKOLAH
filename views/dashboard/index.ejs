<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<!-- Page Header -->
<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Dashboard Overview</h1>
    <p class="page-subtitle">Selamat datang di Sistem Informasi Akademik Sekolah (SIA)</p>
  </div>
  <div class="d-flex gap-2">
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-7">
      <i class="fas fa-circle text-success me-1"></i> Database Online
    </span>
  </div>
</div>

<!-- 4 Statistic Cards -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Total Siswa</div>
          <div class="stat-number"><%= stats.totalSiswa %></div>
          <small class="text-success fw-medium"><i class="fas fa-user-check me-1"></i> Terdaftar Aktif</small>
        </div>
        <div class="stat-icon-wrapper icon-blue">
          <i class="fas fa-user-graduate"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Total Guru</div>
          <div class="stat-number"><%= stats.totalGuru %></div>
          <small class="text-primary fw-medium"><i class="fas fa-chalkboard-teacher me-1"></i> Pengajar Aktif</small>
        </div>
        <div class="stat-icon-wrapper icon-emerald">
          <i class="fas fa-chalkboard-teacher"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Total Rombel / Kelas</div>
          <div class="stat-number"><%= stats.totalKelas %></div>
          <small class="text-purple fw-medium"><i class="fas fa-door-open me-1"></i> Tingkat X, XI, XII</small>
        </div>
        <div class="stat-icon-wrapper icon-purple">
          <i class="fas fa-school"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Mata Pelajaran</div>
          <div class="stat-number"><%= stats.totalMapel %></div>
          <small class="text-amber fw-medium"><i class="fas fa-book me-1"></i> Kurikulum Merdeka</small>
        </div>
        <div class="stat-icon-wrapper icon-amber">
          <i class="fas fa-book-open"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-chart-bar text-primary me-2"></i>Distribusi Siswa per Kelas</h6>
        <span class="badge bg-light text-muted">Statistik Rombel</span>
      </div>
      <div class="card-body p-4">
        <canvas id="studentsPerClassChart" style="max-height: 280px;"></canvas>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-chart-pie text-primary me-2"></i>Komposisi Gender Siswa</h6>
        <span class="badge bg-light text-muted">L / P</span>
      </div>
      <div class="card-body p-4 d-flex align-items-center justify-content-center">
        <div style="width: 100%; max-width: 250px;">
          <canvas id="genderDistributionChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Role Specific Content -->
<% if (currentUser.role === 'siswa' && roleData.siswa) { %>
  <!-- Student Personalized Dashboard Section -->
  <div class="row g-4">
    <div class="col-12 col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-star text-warning me-2"></i>Rangkuman Nilai Akademik Terkini</h6>
          <a href="/nilai/saya" class="btn btn-sm btn-outline-primary rounded-pill px-3">Lihat Rapor Lengkap</a>
        </div>
        <div class="card-body p-0">
          <div class="p-3 bg-light-subtle border-bottom d-flex justify-content-around text-center">
            <div>
              <div class="text-muted small">Rata-Rata Nilai</div>
              <div class="fs-4 fw-bold text-primary"><%= roleData.rataRataNilai %></div>
            </div>
            <div class="border-end"></div>
            <div>
              <div class="text-muted small">Mapel Terdata</div>
              <div class="fs-4 fw-bold text-dark"><%= roleData.totalMataPelajaranDiambil %></div>
            </div>
            <div class="border-end"></div>
            <div>
              <div class="text-muted small">Kelas Anda</div>
              <div class="fs-4 fw-bold text-success"><%= roleData.siswa.nama_kelas || '-' %></div>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-4">Mata Pelajaran</th>
                  <th class="text-center">Tugas</th>
                  <th class="text-center">UTS</th>
                  <th class="text-center">UAS</th>
                  <th class="text-center">Akhir</th>
                  <th class="pe-4 text-center">Predikat</th>
                </tr>
              </thead>
              <tbody>
                <% if (roleData.nilaiList && roleData.nilaiList.length > 0) { %>
                  <% roleData.nilaiList.forEach(n => { %>
                    <tr>
                      <td class="ps-4 fw-semibold"><%= n.nama_mapel %></td>
                      <td class="text-center"><%= n.nilai_tugas %></td>
                      <td class="text-center"><%= n.nilai_uts %></td>
                      <td class="text-center"><%= n.nilai_uas %></td>
                      <td class="text-center fw-bold text-primary"><%= n.nilai_akhir %></td>
                      <td class="pe-4 text-center">
                        <span class="badge badge-grade-<%= n.predikat.replace('+', 'p') %> px-2 py-1"><%= n.predikat %></span>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">Belum ada catatan nilai yang diinputkan.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-calendar-day text-info me-2"></i>Jadwal Pelajaran Kelas <%= roleData.siswa.nama_kelas || '' %></h6>
          <a href="/jadwal" class="btn btn-sm btn-outline-info rounded-pill px-3">Semua Jadwal</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-4">Hari &amp; Waktu</th>
                  <th>Mata Pelajaran</th>
                  <th>Guru</th>
                  <th class="pe-4">Ruangan</th>
                </tr>
              </thead>
              <tbody>
                <% if (roleData.jadwalList && roleData.jadwalList.length > 0) { %>
                  <% roleData.jadwalList.forEach(j => { %>
                    <tr>
                      <td class="ps-4">
                        <span class="badge bg-secondary-subtle text-secondary fw-semibold me-1"><%= j.hari %></span>
                        <small class="text-muted"><%= j.jam_mulai.slice(0, 5) %> - <%= j.jam_selesai.slice(0, 5) %></small>
                      </td>
                      <td class="fw-semibold text-dark"><%= j.nama_mapel %></td>
                      <td class="text-muted"><%= j.guru_nama %></td>
                      <td class="pe-4"><span class="badge bg-light text-dark"><%= j.ruangan %></span></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted">Belum ada jadwal yang dijadwalkan.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
<% } else if (currentUser.role === 'guru' && roleData.guru) { %>
  <!-- Teacher Personalized Dashboard Section -->
  <div class="row g-4">
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-calendar-alt text-primary me-2"></i>Jadwal Mengajar Anda</h6>
          <a href="/jadwal" class="btn btn-sm btn-outline-primary rounded-pill px-3">Lihat Semua</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-4">Hari / Jam</th>
                  <th>Kelas</th>
                  <th>Mata Pelajaran</th>
                  <th class="pe-4">Ruangan</th>
                </tr>
              </thead>
              <tbody>
                <% if (roleData.jadwalList && roleData.jadwalList.length > 0) { %>
                  <% roleData.jadwalList.forEach(j => { %>
                    <tr>
                      <td class="ps-4">
                        <span class="badge bg-primary-subtle text-primary fw-semibold me-1"><%= j.hari %></span>
                        <small class="text-muted"><%= j.jam_mulai.slice(0, 5) %> - <%= j.jam_selesai.slice(0, 5) %></small>
                      </td>
                      <td class="fw-bold"><%= j.nama_kelas %></td>
                      <td><%= j.nama_mapel %></td>
                      <td class="pe-4"><span class="badge bg-light text-dark"><%= j.ruangan %></span></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted">Belum ada jadwal mengajar yang ditentukan.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-bottom py-3 px-4">
          <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-book text-success me-2"></i>Mata Pelajaran Diampu</h6>
        </div>
        <div class="card-body p-3">
          <% if (roleData.mapelList && roleData.mapelList.length > 0) { %>
            <ul class="list-group list-group-flush">
              <% roleData.mapelList.forEach(m => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center px-2 py-3 border-bottom">
                  <div>
                    <h6 class="mb-0 fw-bold text-dark"><%= m.nama_mapel %></h6>
                    <small class="text-muted">Kode: <%= m.kode_mapel %></small>
                  </div>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                    <%= m.kategori %>
                  </span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="text-center py-4 text-muted">Belum ada mata pelajaran yang dihubungkan.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <!-- Admin Recent Activities & Quick Actions -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
      <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-bolt text-warning me-2"></i>Aksi Cepat &amp; Panduan Administrasi</h6>
      <span class="badge bg-primary-subtle text-primary">Administrator</span>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-12 col-md-3">
          <a href="/siswa/create" class="card card-body text-center text-decoration-none border p-3 hover-shadow h-100 rounded-3">
            <i class="fas fa-user-plus text-primary fs-3 mb-2"></i>
            <span class="fw-semibold text-dark">Tambah Siswa</span>
            <small class="text-muted">Registrasi data peserta didik baru</small>
          </a>
        </div>
        <div class="col-12 col-md-3">
          <a href="/guru/create" class="card card-body text-center text-decoration-none border p-3 hover-shadow h-100 rounded-3">
            <i class="fas fa-user-tie text-success fs-3 mb-2"></i>
            <span class="fw-semibold text-dark">Tambah Guru</span>
            <small class="text-muted">Registrasi tenaga pendidik</small>
          </a>
        </div>
        <div class="col-12 col-md-3">
          <a href="/nilai/create" class="card card-body text-center text-decoration-none border p-3 hover-shadow h-100 rounded-3">
            <i class="fas fa-pen-nib text-purple fs-3 mb-2"></i>
            <span class="fw-semibold text-dark">Input Nilai</span>
            <small class="text-muted">Entri nilai tugas, UTS, dan UAS</small>
          </a>
        </div>
        <div class="col-12 col-md-3">
          <a href="/jadwal/create" class="card card-body text-center text-decoration-none border p-3 hover-shadow h-100 rounded-3">
            <i class="fas fa-calendar-plus text-amber fs-3 mb-2"></i>
            <span class="fw-semibold text-dark">Atur Jadwal</span>
            <small class="text-muted">Penjadwalan waktu &amp; ruangan</small>
          </a>
        </div>
      </div>
    </div>
  </div>
<% } %>

<!-- Chart.js Render Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Students Per Class Bar Chart
    const classData = <%- JSON.stringify(studentsPerClass || []) %>;
    const classLabels = classData.map(c => c.nama_kelas);
    const classCounts = classData.map(c => c.total_siswa);

    const ctxClass = document.getElementById('studentsPerClassChart');
    if (ctxClass) {
      new Chart(ctxClass, {
        type: 'bar',
        data: {
          labels: classLabels.length > 0 ? classLabels : ['Belum Ada Kelas'],
          datasets: [{
            label: 'Jumlah Siswa',
            data: classCounts.length > 0 ? classCounts : [0],
            backgroundColor: 'rgba(37, 99, 235, 0.85)',
            borderColor: '#1d4ed8',
            borderWidth: 1,
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              ticks: { stepSize: 1 }
            }
          },
          plugins: {
            legend: { display: false }
          }
        }
      });
    }

    // 2. Gender Distribution Doughnut Chart
    const genderData = <%- JSON.stringify(genderDistribution || []) %>;
    let maleCount = 0;
    let femaleCount = 0;
    genderData.forEach(g => {
      if (g.jenis_kelamin === 'L') maleCount = g.count;
      if (g.jenis_kelamin === 'P') femaleCount = g.count;
    });

    const ctxGender = document.getElementById('genderDistributionChart');
    if (ctxGender) {
      new Chart(ctxGender, {
        type: 'doughnut',
        data: {
          labels: ['Laki-Laki', 'Perempuan'],
          datasets: [{
            data: [maleCount, femaleCount],
            backgroundColor: ['#2563eb', '#ec4899'],
            hoverOffset: 4
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { boxWidth: 12, padding: 16 }
            }
          }
        }
      });
    }
  });
</script>

<%- include('../layouts/footer') %>

