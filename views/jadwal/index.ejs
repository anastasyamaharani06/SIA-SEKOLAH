<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Jadwal Pelajaran</h1>
    <p class="page-subtitle">Susunan jadwal kegiatan belajar mengajar mingguan dan alokasi ruangan</p>
  </div>
  <% if (currentUser.role === 'admin') { %>
    <div>
      <a href="/jadwal/create" class="btn btn-primary rounded-3 px-3 py-2 fw-semibold shadow-sm">
        <i class="fas fa-plus me-1"></i> Tambah Jadwal
      </a>
    </div>
  <% } %>
</div>

<!-- Filters Toolbar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-body p-3">
    <form action="/jadwal" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-4">
        <select class="form-select" name="kelas_id">
          <option value="">Semua Rombel / Kelas</option>
          <% kelasList.forEach(k => { %>
            <option value="<%= k.id %>" <%= filters.kelas_id == k.id ? 'selected' : '' %>><%= k.nama_kelas %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-3">
        <select class="form-select" name="hari">
          <option value="">Semua Hari</option>
          <% ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'].forEach(h => { %>
            <option value="<%= h %>" <%= filters.hari === h ? 'selected' : '' %>><%= h %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-3">
        <select class="form-select" name="guru_id">
          <option value="">Semua Guru Pengampu</option>
          <% guruList.forEach(g => { %>
            <option value="<%= g.id %>" <%= filters.guru_id == g.id ? 'selected' : '' %>><%= g.nama %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">
          <i class="fas fa-filter me-1"></i> Filter
        </button>
        <% if (filters.kelas_id || filters.hari || filters.guru_id) { %>
          <a href="/jadwal" class="btn btn-light border" title="Reset filter">
            <i class="fas fa-undo"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Table Container -->
<div class="card card-table">
  <div class="card-header-custom">
    <span class="fw-bold text-dark fs-6">
      <i class="fas fa-clock text-primary me-2"></i>Daftar Jadwal Pembelajaran (<%= jadwalList.length %> Sesi)
    </span>
  </div>

  <div class="table-responsive">
    <table class="table table-custom">
      <thead>
        <tr>
          <th style="width: 50px;">No</th>
          <th>Hari</th>
          <th>Waktu Pelajaran</th>
          <th>Kelas</th>
          <th>Mata Pelajaran</th>
          <th>Guru Pengampu</th>
          <th>Ruangan</th>
          <% if (currentUser.role === 'admin') { %>
            <th class="text-center" style="width: 140px;">Aksi</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% if (jadwalList && jadwalList.length > 0) { %>
          <% jadwalList.forEach((j, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td>
                <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1">
                  <%= j.hari %>
                </span>
              </td>
              <td>
                <span class="fw-bold text-dark"><%= j.jam_mulai.slice(0, 5) %></span> - <span class="fw-bold text-dark"><%= j.jam_selesai.slice(0, 5) %></span>
              </td>
              <td>
                <span class="badge bg-secondary-subtle text-secondary fw-semibold"><%= j.nama_kelas %></span>
              </td>
              <td class="fw-semibold text-dark"><%= j.nama_mapel %></td>
              <td>
                <div class="d-flex align-items-center gap-1">
                  <i class="fas fa-chalkboard-teacher text-muted"></i>
                  <span><%= j.guru_nama %></span>
                </div>
              </td>
              <td><span class="badge bg-light text-dark border"><%= j.ruangan %></span></td>
              <% if (currentUser.role === 'admin') { %>
                <td class="text-center">
                  <div class="btn-group btn-group-sm" role="group">
                    <a href="/jadwal/edit/<%= j.id %>" class="btn btn-outline-warning" title="Edit Jadwal">
                      <i class="fas fa-edit"></i>
                    </a>
                    <form id="delete-form-jadwal-<%= j.id %>" action="/jadwal/delete/<%= j.id %>" method="POST" class="d-inline">
                      <button type="button" class="btn btn-outline-danger" title="Hapus Jadwal" onclick="confirmDelete('delete-form-jadwal-<%= j.id %>', 'Jadwal <%= j.hari %> - <%= j.nama_mapel %>')">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </td>
              <% } %>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="<%= currentUser.role === 'admin' ? 8 : 7 %>" class="text-center py-5 text-muted">
              <i class="fas fa-calendar-times fs-2 mb-2 d-block text-secondary"></i>
              Tidak ada jadwal pelajaran yang cocok dengan kriteria filter.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>

