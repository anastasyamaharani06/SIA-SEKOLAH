<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<!-- Page Header -->
<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Manajemen Data Siswa</h1>
    <p class="page-subtitle">Kelola seluruh data siswa, profil akademik, dan riwayat belajar</p>
  </div>
  <% if (currentUser.role === 'admin') { %>
    <div>
      <a href="/siswa/create" class="btn btn-primary rounded-3 px-3 py-2 fw-semibold shadow-sm">
        <i class="fas fa-plus me-1"></i> Tambah Siswa
      </a>
    </div>
  <% } %>
</div>

<!-- Filter & Search Toolbar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-body p-3">
    <form action="/siswa" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted">
            <i class="fas fa-search"></i>
          </span>
          <input type="text" class="form-control border-start-0 ps-0" name="search" placeholder="Cari berdasarkan NIS, Nama, atau Alamat..." value="<%= search %>">
        </div>
      </div>
      <div class="col-12 col-md-4">
        <select class="form-select" name="kelas_id">
          <option value="">Semua Rombel / Kelas</option>
          <% kelasList.forEach(k => { %>
            <option value="<%= k.id %>" <%= kelas_id == k.id ? 'selected' : '' %>>
              <%= k.nama_kelas %> (<%= k.tingkat %>)
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">
          <i class="fas fa-filter me-1"></i> Terapkan
        </button>
        <% if (search || kelas_id) { %>
          <a href="/siswa" class="btn btn-light border" title="Reset filter">
            <i class="fas fa-undo"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Table Container -->
<div class="card card-table">
  <div class="card-header-custom">
    <span class="fw-bold text-dark fs-6">
      Total Siswa: <span class="badge bg-primary rounded-pill"><%= totalCount %></span>
    </span>
    <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages || 1 %></small>
  </div>

  <div class="table-responsive">
    <table class="table table-custom">
      <thead>
        <tr>
          <th style="width: 60px;">No</th>
          <th>NIS / NISN</th>
          <th>Nama Lengkap</th>
          <th>L/P</th>
          <th>Kelas</th>
          <th>No. Telepon</th>
          <th class="text-center" style="width: 160px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (siswaList && siswaList.length > 0) { %>
          <% siswaList.forEach((s, idx) => { %>
            <tr>
              <td><%= ((currentPage - 1) * 10) + idx + 1 %></td>
              <td>
                <span class="fw-semibold text-dark"><%= s.nis %></span><br>
                <small class="text-muted"><%= s.nisn %></small>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="avatar-circle" style="width: 32px; height: 32px; font-size: 0.8rem;">
                    <%= s.nama.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <span class="fw-semibold text-dark"><%= s.nama %></span>
                    <% if (s.email) { %><br><small class="text-muted"><%= s.email %></small><% } %>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge <%= s.jenis_kelamin === 'L' ? 'bg-primary-subtle text-primary' : 'bg-pink-subtle text-danger' %> px-2 py-1">
                  <%= s.jenis_kelamin === 'L' ? 'Laki-laki' : 'Perempuan' %>
                </span>
              </td>
              <td>
                <span class="badge bg-secondary-subtle text-secondary fw-semibold">
                  <%= s.nama_kelas || 'Belum Masuk Kelas' %>
                </span>
              </td>
              <td><%= s.no_telp || '-' %></td>
              <td class="text-center">
                <div class="btn-group btn-group-sm" role="group">
                  <a href="/siswa/detail/<%= s.id %>" class="btn btn-outline-info" title="Detail Siswa">
                    <i class="fas fa-eye"></i>
                  </a>
                  <% if (currentUser.role === 'admin') { %>
                    <a href="/siswa/edit/<%= s.id %>" class="btn btn-outline-warning" title="Edit Data">
                      <i class="fas fa-edit"></i>
                    </a>
                    <form id="delete-form-<%= s.id %>" action="/siswa/delete/<%= s.id %>" method="POST" class="d-inline">
                      <button type="button" class="btn btn-outline-danger" title="Hapus Siswa" onclick="confirmDelete('delete-form-<%= s.id %>', '<%= s.nama %>')">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <i class="fas fa-inbox fs-2 mb-2 d-block text-secondary"></i>
              Tidak ada data siswa ditemukan.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
      <small class="text-muted">Menampilkan halaman <%= currentPage %> dari <%= totalPages %></small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/siswa?page=<%= currentPage - 1 %>&search=<%= search %>&kelas_id=<%= kelas_id %>">Sebelumnya</a>
          </li>
          <% for(let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= currentPage === p ? 'active' : '' %>">
              <a class="page-link" href="/siswa?page=<%= p %>&search=<%= search %>&kelas_id=<%= kelas_id %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/siswa?page=<%= currentPage + 1 %>&search=<%= search %>&kelas_id=<%= kelas_id %>">Selanjutnya</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>

