<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Tambah Siswa Baru</h1>
    <p class="page-subtitle">Daftarkan data siswa ke dalam basis data akademik</p>
  </div>
  <a href="/siswa" class="btn btn-outline-secondary rounded-3">
    <i class="fas fa-arrow-left me-1"></i> Kembali
  </a>
</div>

<div class="row">
  <div class="col-12 col-xl-9">
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-user-plus text-primary me-2"></i>Formulir Data Siswa</h6>
      </div>
      <div class="card-body p-4">
        <form action="/siswa" method="POST">
          <div class="row g-3">
            <!-- NIS & NISN -->
            <div class="col-12 col-md-6">
              <label for="nis" class="form-label fw-semibold small">Nomor Induk Siswa (NIS) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nis" name="nis" placeholder="Contoh: 240106" value="<%= formData.nis || '' %>" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="nisn" class="form-label fw-semibold small">NISN Nasional <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nisn" name="nisn" placeholder="Contoh: 0071234566" value="<%= formData.nisn || '' %>" required>
            </div>

            <!-- Nama & Gender -->
            <div class="col-12 col-md-8">
              <label for="nama" class="form-label fw-semibold small">Nama Lengkap Siswa <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nama" name="nama" placeholder="Masukkan nama lengkap siswa" value="<%= formData.nama || '' %>" required>
            </div>
            <div class="col-12 col-md-4">
              <label class="form-label fw-semibold small">Jenis Kelamin <span class="text-danger">*</span></label>
              <div>
                <div class="form-check form-check-inline mt-1">
                  <input class="form-check-input" type="radio" name="jenis_kelamin" id="jkL" value="L" <%= formData.jenis_kelamin === 'L' || !formData.jenis_kelamin ? 'checked' : '' %>>
                  <label class="form-check-label" for="jkL">Laki-Laki</label>
                </div>
                <div class="form-check form-check-inline mt-1">
                  <input class="form-check-input" type="radio" name="jenis_kelamin" id="jkP" value="P" <%= formData.jenis_kelamin === 'P' ? 'checked' : '' %>>
                  <label class="form-check-label" for="jkP">Perempuan</label>
                </div>
              </div>
            </div>

            <!-- Tanggal Lahir & No Telp -->
            <div class="col-12 col-md-6">
              <label for="tanggal_lahir" class="form-label fw-semibold small">Tanggal Lahir <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="tanggal_lahir" name="tanggal_lahir" value="<%= formData.tanggal_lahir || '' %>" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="no_telp" class="form-label fw-semibold small">Nomor Telepon / WhatsApp</label>
              <input type="text" class="form-control" id="no_telp" name="no_telp" placeholder="08xxxxxxxxxx" value="<%= formData.no_telp || '' %>">
            </div>

            <!-- Kelas Rombel -->
            <div class="col-12">
              <label for="kelas_id" class="form-label fw-semibold small">Penempatan Kelas</label>
              <select class="form-select" id="kelas_id" name="kelas_id">
                <option value="">-- Pilih Kelas --</option>
                <% kelasList.forEach(k => { %>
                  <option value="<%= k.id %>" <%= formData.kelas_id == k.id ? 'selected' : '' %>>
                    <%= k.nama_kelas %> (Tingkat <%= k.tingkat %> - Thn <%= k.tahun_ajaran %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Alamat -->
            <div class="col-12">
              <label for="alamat" class="form-label fw-semibold small">Alamat Tempat Tinggal</label>
              <textarea class="form-control" id="alamat" name="alamat" rows="2" placeholder="Alamat domisili lengkap..."><%= formData.alamat || '' %></textarea>
            </div>

            <!-- Akun Pengguna / Login Checkbox -->
            <div class="col-12 mt-4 pt-3 border-top">
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="createAccountCheck" name="create_account" value="yes" checked>
                <label class="form-check-label fw-bold" for="createAccountCheck">Buat Akun Login Siswa Sekaligus</label>
              </div>

              <div id="accountFields" class="row g-3 p-3 bg-light rounded-3">
                <div class="col-12 col-md-4">
                  <label for="username" class="form-label fw-semibold small">Username</label>
                  <input type="text" class="form-control form-control-sm" id="username" name="username" placeholder="Otomatis: siswa_[NIS]">
                </div>
                <div class="col-12 col-md-4">
                  <label for="email" class="form-label fw-semibold small">Email</label>
                  <input type="email" class="form-control form-control-sm" id="email" name="email" placeholder="Otomatis: [NIS]@siswa.sch.id">
                </div>
                <div class="col-12 col-md-4">
                  <label for="password" class="form-label fw-semibold small">Password Awal</label>
                  <input type="text" class="form-control form-control-sm" id="password" name="password" value="siswa123">
                </div>
              </div>
            </div>

            <div class="col-12 mt-4 d-flex justify-content-end gap-2">
              <a href="/siswa" class="btn btn-light border px-4">Batal</a>
              <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="fas fa-save me-1"></i> Simpan Siswa
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  const check = document.getElementById('createAccountCheck');
  const fields = document.getElementById('accountFields');
  if (check && fields) {
    check.addEventListener('change', () => {
      fields.style.display = check.checked ? 'flex' : 'none';
    });
  }
</script>

<%- include('../layouts/footer') %>

