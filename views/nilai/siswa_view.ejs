<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Rapor Hasil Belajar Siswa</h1>
    <p class="page-subtitle">Transkrip dan capaian evaluasi kompetensi akademik</p>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary rounded-3" onclick="window.print()">
      <i class="fas fa-print me-1"></i> Cetak Rapor
    </button>
  </div>
</div>

<!-- Student Header Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-body p-4">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-md-3 border-end">
        <span class="text-muted small d-block">Nama Peserta Didik</span>
        <span class="fs-5 fw-bold text-dark"><%= siswa.nama %></span>
        <small class="text-muted d-block">NIS: <%= siswa.nis %> | NISN: <%= siswa.nisn %></small>
      </div>
      <div class="col-12 col-md-3 border-end">
        <span class="text-muted small d-block">Rombongan Belajar (Kelas)</span>
        <span class="fs-5 fw-bold text-primary"><%= siswa.nama_kelas || '-' %></span>
        <small class="text-muted d-block">Tahun Ajaran: <%= siswa.tahun_ajaran || '2024/2025' %></small>
      </div>
      <div class="col-12 col-md-3 border-end">
        <span class="text-muted small d-block">Rata-Rata Nilai Akhir</span>
        <span class="fs-4 fw-bold text-success"><%= rataRata %></span>
        <small class="text-muted d-block">Dari <%= nilaiList.length %> Mata Pelajaran</small>
      </div>
      <div class="col-12 col-md-3">
        <span class="text-muted small d-block">Status Akademik</span>
        <span class="badge bg-success-subtle text-success fs-7 px-3 py-2 rounded-pill mt-1">
          <i class="fas fa-check-circle me-1"></i> Aktif Berprestasi
        </span>
      </div>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4 d-print-none">
  <div class="card-body p-3">
    <form action="/nilai/saya" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-4">
        <select class="form-select" name="semester">
          <option value="">Semua Semester</option>
          <option value="Ganjil" <%= filters.semester === 'Ganjil' ? 'selected' : '' %>>Semester Ganjil</option>
          <option value="Genap" <%= filters.semester === 'Genap' ? 'selected' : '' %>>Semester Genap</option>
        </select>
      </div>
      <div class="col-12 col-md-4">
        <input type="text" class="form-control" name="tahun_ajaran" placeholder="Tahun Ajaran (Contoh: 2024/2025)" value="<%= filters.tahun_ajaran %>">
      </div>
      <div class="col-12 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">
          <i class="fas fa-filter me-1"></i> Filter Semester
        </button>
        <% if (filters.semester || filters.tahun_ajaran) { %>
          <a href="/nilai/saya" class="btn btn-light border" title="Reset filter">
            <i class="fas fa-undo"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Grades Table -->
<div class="card card-table mb-4">
  <div class="card-header-custom">
    <span class="fw-bold text-dark fs-6">
      <i class="fas fa-clipboard-list text-primary me-2"></i>Daftar Capaian Nilai Per Mata Pelajaran
    </span>
    <span class="badge bg-primary rounded-pill"><%= nilaiList.length %> Mata Pelajaran</span>
  </div>

  <div class="table-responsive">
    <table class="table table-custom">
      <thead>
        <tr>
          <th style="width: 50px;">No</th>
          <th>Kode</th>
          <th>Mata Pelajaran</th>
          <th>Kategori</th>
          <th>Guru Pengampu</th>
          <th class="text-center">Tugas (30%)</th>
          <th class="text-center">UTS (30%)</th>
          <th class="text-center">UAS (40%)</th>
          <th class="text-center">Nilai Akhir</th>
          <th class="text-center">Predikat</th>
          <th class="pe-4">Keterangan</th>
        </tr>
      </thead>
      <tbody>
        <% if (nilaiList && nilaiList.length > 0) { %>
          <% nilaiList.forEach((n, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><span class="badge bg-light text-dark border"><%= n.kode_mapel %></span></td>
              <td class="fw-bold text-dark"><%= n.nama_mapel %></td>
              <td><span class="badge bg-secondary-subtle text-secondary"><%= n.kategori %></span></td>
              <td class="text-muted"><%= n.guru_nama || '-' %></td>
              <td class="text-center"><%= n.nilai_tugas %></td>
              <td class="text-center"><%= n.nilai_uts %></td>
              <td class="text-center"><%= n.nilai_uas %></td>
              <td class="text-center fw-bold text-primary fs-6"><%= n.nilai_akhir %></td>
              <td class="text-center">
                <span class="badge badge-grade-<%= n.predikat.replace('+', 'p') %> px-2 py-1"><%= n.predikat %></span>
              </td>
              <td class="pe-4"><small class="fw-medium text-dark"><%= n.keterangan %></small></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="11" class="text-center py-5 text-muted">
              <i class="fas fa-inbox fs-2 mb-2 d-block text-secondary"></i>
              Belum ada nilai yang tersedia untuk periode ini.
            </td>
          </tr>
        <% } %>
      </tbody>
      <% if (nilaiList && nilaiList.length > 0) { %>
        <tfoot class="table-light border-top">
          <tr>
            <td colspan="8" class="text-end fw-bold ps-4">Rata-Rata Nilai Akhir:</td>
            <td class="text-center fw-bold text-success fs-5"><%= rataRata %></td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      <% } %>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>

