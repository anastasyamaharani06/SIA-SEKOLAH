<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Penilaian Akademik</h1>
    <p class="page-subtitle">Kelola nilai tugas, UTS, UAS, dan evaluasi hasil belajar siswa</p>
  </div>
  <div>
    <a href="/nilai/create" class="btn btn-primary rounded-3 px-3 py-2 fw-semibold shadow-sm">
      <i class="fas fa-plus me-1"></i> Input Nilai Siswa
    </a>
  </div>
</div>

<!-- Score Statistics Cards -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-4">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <small class="text-muted text-uppercase fw-semibold">Rata-Rata Seluruh Nilai</small>
          <h3 class="fw-bold text-primary mb-0">
            <%= summaryStats && summaryStats.rata_rata_keseluruhan ? parseFloat(summaryStats.rata_rata_keseluruhan).toFixed(2) : '0.00' %>
          </h3>
        </div>
        <div class="stat-icon-wrapper icon-blue">
          <i class="fas fa-chart-line"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-4">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <small class="text-muted text-uppercase fw-semibold">Nilai Tertinggi</small>
          <h3 class="fw-bold text-success mb-0">
            <%= summaryStats && summaryStats.nilai_tertinggi ? parseFloat(summaryStats.nilai_tertinggi).toFixed(2) : '0.00' %>
          </h3>
        </div>
        <div class="stat-icon-wrapper icon-emerald">
          <i class="fas fa-trophy"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-4">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <small class="text-muted text-uppercase fw-semibold">Total Entri Penilaian</small>
          <h3 class="fw-bold text-dark mb-0">
            <%= summaryStats && summaryStats.total_entri_nilai ? summaryStats.total_entri_nilai : '0' %>
          </h3>
        </div>
        <div class="stat-icon-wrapper icon-purple">
          <i class="fas fa-list-check"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filters Toolbar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-body p-3">
    <form action="/nilai" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-3">
        <input type="text" class="form-control" name="search" placeholder="Cari nama atau NIS siswa..." value="<%= filters.search %>">
      </div>
      <div class="col-6 col-md-2">
        <select class="form-select" name="kelas_id">
          <option value="">Semua Kelas</option>
          <% kelasList.forEach(k => { %>
            <option value="<%= k.id %>" <%= filters.kelas_id == k.id ? 'selected' : '' %>><%= k.nama_kelas %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <select class="form-select" name="mapel_id">
          <option value="">Semua Mata Pelajaran</option>
          <% mapelList.forEach(m => { %>
            <option value="<%= m.id %>" <%= filters.mapel_id == m.id ? 'selected' : '' %>><%= m.nama_mapel %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <select class="form-select" name="semester">
          <option value="">Semua Semester</option>
          <option value="Ganjil" <%= filters.semester === 'Ganjil' ? 'selected' : '' %>>Ganjil</option>
          <option value="Genap" <%= filters.semester === 'Genap' ? 'selected' : '' %>>Genap</option>
        </select>
      </div>
      <div class="col-6 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">
          <i class="fas fa-filter me-1"></i> Filter
        </button>
        <% if (filters.search || filters.kelas_id || filters.mapel_id || filters.semester || filters.tahun_ajaran) { %>
          <a href="/nilai" class="btn btn-light border" title="Reset filter">
            <i class="fas fa-undo"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Table Container -->
<div class="card card-table">
  <div class="card-header-custom">
    <span class="fw-bold text-dark fs-6">
      Data Nilai Siswa (<%= totalCount %> Data)
    </span>
    <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages || 1 %></small>
  </div>

  <div class="table-responsive">
    <table class="table table-custom">
      <thead>
        <tr>
          <th style="width: 50px;">No</th>
          <th>Siswa</th>
          <th>Kelas</th>
          <th>Mata Pelajaran</th>
          <th>Semester</th>
          <th class="text-center">Tugas (30%)</th>
          <th class="text-center">UTS (30%)</th>
          <th class="text-center">UAS (40%)</th>
          <th class="text-center">Nilai Akhir</th>
          <th class="text-center">Predikat</th>
          <th class="text-center" style="width: 130px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (nilaiList && nilaiList.length > 0) { %>
          <% nilaiList.forEach((n, idx) => { %>
            <tr>
              <td><%= ((currentPage - 1) * 10) + idx + 1 %></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="avatar-circle" style="width: 28px; height: 28px; font-size: 0.75rem;">
                    <%= n.siswa_nama.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <span class="fw-semibold text-dark"><%= n.siswa_nama %></span><br>
                    <small class="text-muted">NIS: <%= n.siswa_nis %></small>
                  </div>
                </div>
              </td>
              <td><span class="badge bg-secondary-subtle text-secondary fw-semibold"><%= n.nama_kelas || '-' %></span></td>
              <td class="fw-medium text-dark"><%= n.nama_mapel %></td>
              <td><%= n.semester %> <small class="text-muted">(<%= n.tahun_ajaran %>)</small></td>
              <td class="text-center"><%= n.nilai_tugas %></td>
              <td class="text-center"><%= n.nilai_uts %></td>
              <td class="text-center"><%= n.nilai_uas %></td>
              <td class="text-center fw-bold text-primary fs-6"><%= n.nilai_akhir %></td>
              <td class="text-center">
                <span class="badge badge-grade-<%= n.predikat.replace('+', 'p') %> px-2 py-1"><%= n.predikat %></span>
              </td>
              <td class="text-center">
                <div class="btn-group btn-group-sm" role="group">
                  <a href="/nilai/edit/<%= n.id %>" class="btn btn-outline-warning" title="Edit Nilai">
                    <i class="fas fa-edit"></i>
                  </a>
                  <form id="delete-form-nilai-<%= n.id %>" action="/nilai/delete/<%= n.id %>" method="POST" class="d-inline">
                    <button type="button" class="btn btn-outline-danger" title="Hapus Nilai" onclick="confirmDelete('delete-form-nilai-<%= n.id %>', 'Nilai <%= n.siswa_nama %> - <%= n.nama_mapel %>')">
                      <i class="fas fa-trash-alt"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="11" class="text-center py-5 text-muted">
              <i class="fas fa-file-invoice fs-2 mb-2 d-block text-secondary"></i>
              Tidak ada data penilaian akademik yang sesuai filter.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
      <small class="text-muted">Menampilkan halaman <%= currentPage %> dari <%= totalPages %></small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/nilai?page=<%= currentPage - 1 %>&search=<%= filters.search %>&kelas_id=<%= filters.kelas_id %>&mapel_id=<%= filters.mapel_id %>&semester=<%= filters.semester %>">Sebelumnya</a>
          </li>
          <% for(let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= currentPage === p ? 'active' : '' %>">
              <a class="page-link" href="/nilai?page=<%= p %>&search=<%= filters.search %>&kelas_id=<%= filters.kelas_id %>&mapel_id=<%= filters.mapel_id %>&semester=<%= filters.semester %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/nilai?page=<%= currentPage + 1 %>&search=<%= filters.search %>&kelas_id=<%= filters.kelas_id %>&mapel_id=<%= filters.mapel_id %>&semester=<%= filters.semester %>">Selanjutnya</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>

