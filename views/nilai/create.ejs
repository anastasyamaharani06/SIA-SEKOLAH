<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Input Penilaian Siswa</h1>
    <p class="page-subtitle">Entri nilai tugas, ujian tengah semester (UTS), dan ujian akhir semester (UAS)</p>
  </div>
  <a href="/nilai" class="btn btn-outline-secondary rounded-3">
    <i class="fas fa-arrow-left me-1"></i> Kembali
  </a>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-edit text-primary me-2"></i>Formulir Input Nilai</h6>
      </div>
      <div class="card-body p-4">
        <form action="/nilai" method="POST">
          <div class="row g-3">
            <!-- Siswa -->
            <div class="col-12">
              <label for="siswa_id" class="form-label fw-semibold small">Pilih Siswa <span class="text-danger">*</span></label>
              <select class="form-select" id="siswa_id" name="siswa_id" required>
                <option value="">-- Pilih Siswa --</option>
                <% siswaList.forEach(s => { %>
                  <option value="<%= s.id %>">
                    <%= s.nama %> (NIS: <%= s.nis %> - Kelas: <%= s.nama_kelas || 'Tanpa Kelas' %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Mapel -->
            <div class="col-12">
              <label for="mapel_id" class="form-label fw-semibold small">Mata Pelajaran <span class="text-danger">*</span></label>
              <select class="form-select" id="mapel_id" name="mapel_id" required>
                <option value="">-- Pilih Mata Pelajaran --</option>
                <% mapelList.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.nama_mapel %> (<%= m.kode_mapel %>)</option>
                <% }) %>
              </select>
            </div>

            <!-- Semester & Tahun Ajaran -->
            <div class="col-12 col-md-6">
              <label for="semester" class="form-label fw-semibold small">Semester <span class="text-danger">*</span></label>
              <select class="form-select" id="semester" name="semester" required>
                <option value="Ganjil">Semester Ganjil</option>
                <option value="Genap">Semester Genap</option>
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label for="tahun_ajaran" class="form-label fw-semibold small">Tahun Ajaran <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="tahun_ajaran" name="tahun_ajaran" value="2024/2025" required>
            </div>

            <!-- Nilai Components -->
            <div class="col-12 col-md-4">
              <label for="nilai_tugas" class="form-label fw-semibold small">Nilai Tugas (Bobot 30%)</label>
              <input type="number" step="0.01" min="0" max="100" class="form-control" id="nilai_tugas" name="nilai_tugas" placeholder="0 - 100" value="85" required>
            </div>
            <div class="col-12 col-md-4">
              <label for="nilai_uts" class="form-label fw-semibold small">Nilai UTS (Bobot 30%)</label>
              <input type="number" step="0.01" min="0" max="100" class="form-control" id="nilai_uts" name="nilai_uts" placeholder="0 - 100" value="80" required>
            </div>
            <div class="col-12 col-md-4">
              <label for="nilai_uas" class="form-label fw-semibold small">Nilai UAS (Bobot 40%)</label>
              <input type="number" step="0.01" min="0" max="100" class="form-control" id="nilai_uas" name="nilai_uas" placeholder="0 - 100" value="85" required>
            </div>

            <div class="col-12 mt-4 d-flex justify-content-end gap-2">
              <a href="/nilai" class="btn btn-light border px-4">Batal</a>
              <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="fas fa-save me-1"></i> Simpan Nilai
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Real-time Live Score Preview Card -->
  <div class="col-12 col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 text-center p-4">
      <div class="stat-icon-wrapper icon-blue mx-auto mb-3" style="width: 60px; height: 60px;">
        <i class="fas fa-calculator fs-3"></i>
      </div>
      <h6 class="fw-bold text-dark mb-1">Simulasi Perhitungan Nilai</h6>
      <small class="text-muted mb-4 d-block">Formula: (30% Tugas) + (30% UTS) + (40% UAS)</small>

      <div class="p-3 bg-light rounded-3 mb-3">
        <span class="text-muted small d-block mb-1">Estimasi Nilai Akhir</span>
        <div class="fs-1 fw-bold text-primary" id="preview_nilai_akhir">83.50</div>
      </div>

      <div>
        <span class="text-muted small d-block mb-2">Estimasi Predikat</span>
        <span id="preview_predikat" class="badge bg-primary fs-6 px-3 py-2">B+ (Sangat Baik)</span>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

