<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Tambah Guru Baru</h1>
    <p class="page-subtitle">Daftarkan tenaga pendidik baru ke dalam sistem</p>
  </div>
  <a href="/guru" class="btn btn-outline-secondary rounded-3">
    <i class="fas fa-arrow-left me-1"></i> Kembali
  </a>
</div>

<div class="row">
  <div class="col-12 col-xl-9">
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-user-plus text-success me-2"></i>Formulir Data Tenaga Pendidik</h6>
      </div>
      <div class="card-body p-4">
        <form action="/guru" method="POST">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="nip" class="form-label fw-semibold small">Nomor Induk Pegawai (NIP) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nip" name="nip" placeholder="Contoh: 198501152010011005" value="<%= formData.nip || '' %>" required>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small">Jenis Kelamin <span class="text-danger">*</span></label>
              <div>
                <div class="form-check form-check-inline mt-1">
                  <input class="form-check-input" type="radio" name="jenis_kelamin" id="jkL" value="L" <%= formData.jenis_kelamin === 'L' || !formData.jenis_kelamin ? 'checked' : '' %>>
                  <label class="form-check-label" for="jkL">Laki-Laki</label>
                </div>
                <div class="form-check form-check-inline mt-1">
                  <input class="form-check-input" type="radio" name="jenis_kelamin" id="jkP" value="P" <%= formData.jenis_kelamin === 'P' ? 'checked' : '' %>>
                  <label class="form-check-label" for="jkP">Perempuan</label>
                </div>
              </div>
            </div>

            <div class="col-12 col-md-8">
              <label for="nama" class="form-label fw-semibold small">Nama Lengkap &amp; Gelar <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nama" name="nama" placeholder="Contoh: Drs. Bambang Supeno, M.Pd." value="<%= formData.nama || '' %>" required>
            </div>
            <div class="col-12 col-md-4">
              <label for="no_telp" class="form-label fw-semibold small">No. Telepon / WhatsApp</label>
              <input type="text" class="form-control" id="no_telp" name="no_telp" placeholder="08xxxxxxxxxx" value="<%= formData.no_telp || '' %>">
            </div>

            <div class="col-12">
              <label for="alamat" class="form-label fw-semibold small">Alamat Tempat Tinggal</label>
              <textarea class="form-control" id="alamat" name="alamat" rows="2" placeholder="Alamat domisili lengkap guru..."><%= formData.alamat || '' %></textarea>
            </div>

            <!-- Akun Pengguna / Login Checkbox -->
            <div class="col-12 mt-4 pt-3 border-top">
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="createAccountCheck" name="create_account" value="yes" checked>
                <label class="form-check-label fw-bold" for="createAccountCheck">Buat Akun Login Guru Sekaligus</label>
              </div>

              <div id="accountFields" class="row g-3 p-3 bg-light rounded-3">
                <div class="col-12 col-md-4">
                  <label for="username" class="form-label fw-semibold small">Username</label>
                  <input type="text" class="form-control form-control-sm" id="username" name="username" placeholder="Otomatis: guru_[NIP]">
                </div>
                <div class="col-12 col-md-4">
                  <label for="email" class="form-label fw-semibold small">Email</label>
                  <input type="email" class="form-control form-control-sm" id="email" name="email" placeholder="Otomatis: [NIP]@sekolah.sch.id">
                </div>
                <div class="col-12 col-md-4">
                  <label for="password" class="form-label fw-semibold small">Password Awal</label>
                  <input type="text" class="form-control form-control-sm" id="password" name="password" value="guru123">
                </div>
              </div>
            </div>

            <div class="col-12 mt-4 d-flex justify-content-end gap-2">
              <a href="/guru" class="btn btn-light border px-4">Batal</a>
              <button type="submit" class="btn btn-success px-4 fw-semibold text-white">
                <i class="fas fa-save me-1"></i> Simpan Guru
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  const check = document.getElementById('createAccountCheck');
  const fields = document.getElementById('accountFields');
  if (check && fields) {
    check.addEventListener('change', () => {
      fields.style.display = check.checked ? 'flex' : 'none';
    });
  }
</script>

<%- include('../layouts/footer') %>

