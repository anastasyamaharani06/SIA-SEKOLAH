<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>
<%- include('../layouts/navbar') %>

<div class="page-title-box d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1 class="page-title">Detail Tenaga Pendidik</h1>
    <p class="page-subtitle">Informasi profil guru, mata pelajaran yang diampu, dan jadwal mengajar</p>
  </div>
  <div class="d-flex gap-2">
    <% if (currentUser.role === 'admin') { %>
      <a href="/guru/edit/<%= guru.id %>" class="btn btn-warning rounded-3 px-3">
        <i class="fas fa-edit me-1"></i> Edit Data
      </a>
    <% } %>
    <a href="/guru" class="btn btn-outline-secondary rounded-3">
      <i class="fas fa-arrow-left me-1"></i> Kembali
    </a>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Profile Info Card -->
  <div class="col-12 col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
      <div class="avatar-circle mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.2rem; background: linear-gradient(135deg, #10b981, #059669);">
        <%= guru.nama.charAt(0).toUpperCase() %>
      </div>
      <h5 class="fw-bold text-dark mb-1"><%= guru.nama %></h5>
      <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-3 align-self-center">
        Guru Pendidik
      </span>

      <ul class="list-group list-group-flush text-start small">
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">NIP</span>
          <span class="fw-semibold text-dark"><%= guru.nip %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Jenis Kelamin</span>
          <span class="fw-semibold text-dark"><%= guru.jenis_kelamin === 'L' ? 'Laki-Laki' : 'Perempuan' %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Telepon / WhatsApp</span>
          <span class="fw-semibold text-dark"><%= guru.no_telp || '-' %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Username Akun</span>
          <span class="fw-semibold text-primary"><%= guru.username || '(Belum terhubung)' %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0 py-2">
          <span class="text-muted">Email Sekolah</span>
          <span class="fw-semibold text-dark"><%= guru.email || '-' %></span>
        </li>
        <li class="list-group-item px-0 py-2">
          <span class="text-muted d-block mb-1">Alamat Tempat Tinggal</span>
          <span class="fw-medium text-dark"><%= guru.alamat || '-' %></span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Subjects & Schedules Card -->
  <div class="col-12 col-lg-8">
    <!-- Assigned Subjects -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-book text-success me-2"></i>Mata Pelajaran yang Diampu</h6>
      </div>
      <div class="card-body p-3">
        <% if (mapelList && mapelList.length > 0) { %>
          <div class="row g-2">
            <% mapelList.forEach(m => { %>
              <div class="col-12 col-md-6">
                <div class="p-3 border rounded-3 bg-light-subtle d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="mb-0 fw-bold text-dark"><%= m.nama_mapel %></h6>
                    <small class="text-muted">Kode: <%= m.kode_mapel %></small>
                  </div>
                  <span class="badge bg-primary-subtle text-primary"><%= m.kategori %></span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted mb-0 small">Belum ada mata pelajaran yang ditugaskan kepada guru ini.</p>
        <% } %>
      </div>
    </div>

    <!-- Teaching Schedule -->
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-calendar-alt text-primary me-2"></i>Jadwal Mengajar di Kelas</h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Hari</th>
                <th>Waktu</th>
                <th>Kelas</th>
                <th>Mata Pelajaran</th>
                <th class="pe-4">Ruangan</th>
              </tr>
            </thead>
            <tbody>
              <% if (jadwalList && jadwalList.length > 0) { %>
                <% jadwalList.forEach(j => { %>
                  <tr>
                    <td class="ps-4 fw-semibold"><%= j.hari %></td>
                    <td><%= j.jam_mulai.slice(0, 5) %> - <%= j.jam_selesai.slice(0, 5) %></td>
                    <td><span class="badge bg-secondary-subtle text-secondary fw-semibold"><%= j.nama_kelas %></span></td>
                    <td class="fw-semibold text-dark"><%= j.nama_mapel %></td>
                    <td class="pe-4"><span class="badge bg-light text-dark"><%= j.ruangan %></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">Belum ada jadwal mengajar.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

