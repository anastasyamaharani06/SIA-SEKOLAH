<div class="app-main">
  <!-- Top Navbar -->
  <header class="app-navbar">
    <div class="d-flex align-items-center gap-3">
      <button type="button" class="sidebar-toggle-btn d-lg-none" id="sidebarToggle" aria-label="Toggle Sidebar">
        <i class="fas fa-bars"></i>
      </button>
      <div class="d-none d-md-flex flex-column">
        <span class="fw-bold text-dark fs-6">Sistem Informasi Akademik</span>
        <small class="text-muted" style="font-size: 0.75rem;">
          <i class="far fa-calendar-alt me-1"></i>
          <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
        </small>
      </div>
    </div>

    <!-- User Menu Dropdown -->
    <div class="d-flex align-items-center gap-3">
      <div class="dropdown">
        <button class="btn btn-light d-flex align-items-center gap-2 border-0 bg-transparent py-1 px-2 rounded-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <div class="avatar-circle" style="width: 34px; height: 34px; font-size: 0.85rem;">
            <%= currentUser && currentUser.nama ? currentUser.nama.charAt(0).toUpperCase() : 'U' %>
          </div>
          <div class="d-none d-sm-flex flex-column text-start">
            <span class="fw-semibold text-dark lh-sm" style="font-size: 0.85rem;">
              <%= currentUser ? currentUser.nama : 'Pengguna' %>
            </span>
            <span class="text-muted" style="font-size: 0.72rem; text-transform: capitalize;">
              Role: <%= currentUser ? currentUser.role : 'Guest' %>
            </span>
          </div>
          <i class="fas fa-chevron-down text-muted ms-1" style="font-size: 0.75rem;"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" style="min-width: 200px;">
          <li class="px-3 py-2 border-bottom">
            <p class="mb-0 fw-semibold text-dark" style="font-size: 0.85rem;"><%= currentUser ? currentUser.nama : '' %></p>
            <small class="text-muted" style="font-size: 0.75rem;"><%= currentUser ? currentUser.email : '' %></small>
          </li>
          <li>
            <a class="dropdown-item py-2" href="/profile">
              <i class="fas fa-user-circle me-2 text-primary"></i> Profil Saya
            </a>
          </li>
          <li>
            <a class="dropdown-item py-2" href="/profile#passwordSection">
              <i class="fas fa-key me-2 text-warning"></i> Ubah Password
            </a>
          </li>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <a class="dropdown-item py-2 text-danger" href="/auth/logout">
              <i class="fas fa-sign-out-alt me-2"></i> Keluar
            </a>
          </li>
        </ul>
      </div>
    </div>
  </header>

  <!-- Flash Messages & Page Container -->
  <main class="app-content">
    <% if (typeof successMsg !== 'undefined' && successMsg.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center">
          <i class="fas fa-check-circle fs-5 me-2"></i>
          <div><%= successMsg %></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof errorMsg !== 'undefined' && errorMsg.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center">
          <i class="fas fa-exclamation-circle fs-5 me-2"></i>
          <div><%= errorMsg %></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof warningMsg !== 'undefined' && warningMsg.length > 0) { %>
      <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center">
          <i class="fas fa-exclamation-triangle fs-5 me-2"></i>
          <div><%= warningMsg %></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

